# Cloud Firestore Production Configuration
# Provide Firebase service account credentials to connect the application to your dedicated Cloud Firestore database.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=

# Optional CORS Origin (if frontend and backend are hosted on separate domains)
CORS_ORIGIN=
